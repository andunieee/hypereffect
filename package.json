{
  "name": "@hypereffect/server",
  "version": "0.1.0",
  "description": "Types and helpers for writing hypereffect servers: messages, line framing, signals and components, an App/Server session driver, and a renderer client with a loopback for tests.",
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./client": { "types": "./dist/client.d.ts", "default": "./dist/client.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": { "@marcbachmann/cel-js": "8.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^7.0.0" },
  "engines": { "node": ">=20" },
  "repository": { "type": "git", "url": "git+https://github.com/hypereffect/hypereffect-ts.git" },
  "bugs": "https://github.com/hypereffect/hypereffect-ts/issues",
  "homepage": "https://hypereffect.dev",
  "keywords": ["hypermedia", "gui", "ui", "server-driven-ui", "cel"],
  "license": "MIT"
}
